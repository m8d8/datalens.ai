# Datalens Secrets — Template
#
# SETUP:
# 1. Copy this file to secrets.yaml (same directory): cp secrets.yaml.example secrets.yaml
# 2. Fill in your actual credentials below
# 3. Keep secrets.yaml git-ignored (already in .gitignore)
# 4. Datalens loads automatically — no --secrets flag needed
#
# LOADED FROM:
# - .datalens/secrets.yaml (project-local, checked first)
# - ~/.datalens/secrets.yaml (user-global, fallback)
#
# NEVER COMMIT actual secrets! Only commit this .example file.

# ═══════════════════════════════════════════════════════════════════════
# DATA SOURCE CREDENTIALS
# ═══════════════════════════════════════════════════════════════════════

# MongoDB connection
mongodb:
  uri: "mongodb+srv://user:pass@cluster.mongodb.net"
  # Or use environment variable: DATALENS_MONGO_URI

# S3 access (for s3:// sources)
s3:
  access_key_id: "AKIA..."
  secret_access_key: "..."
  region: "us-east-1"

# HTTP/HTTPS (for authenticated endpoints)
http:
  default_headers:
    Authorization: "Bearer ..."
    X-API-Key: "..."

# ═══════════════════════════════════════════════════════════════════════
# AI PROVIDER CONFIGURATION (for --ai flag)
# ═══════════════════════════════════════════════════════════════════════

# Anthropic API (Claude via API)
# Usage: datalens analyze --source file --path data.csv --ai anthropic
anthropic:
  api_key: "sk-ant-..."              # Required for API access
  model: "claude-sonnet-4-20250514"  # Optional: claude-opus-4-1, claude-haiku-4-5-20251001
  timeout: 60                         # Optional: request timeout in seconds
  # Or use environment variables: ANTHROPIC_API_KEY, DATALENS_ANTHROPIC_MODEL

# OpenAI API (GPT-4, GPT-3.5)
# Usage: datalens analyze --source file --path data.csv --ai openai
openai:
  api_key: "sk-..."                  # Required for API access
  # Or use environment variable: OPENAI_API_KEY

# Claude Desktop / Claude Code (License)
# Usage: datalens analyze --source file --path data.csv --ai claude
# No config needed if `claude` CLI is authenticated
claude:
  cli_path: "/path/to/claude"        # Optional: path to claude CLI if not in PATH
  timeout: 180                       # Optional: request timeout in seconds

# GitHub Copilot (License via GitHub CLI)
# Usage: datalens analyze --source file --path data.csv --ai copilot
# No config needed if `gh` CLI is authenticated and Copilot is available
copilot:
  gh_path: "/usr/local/bin/gh"       # Optional: path to gh CLI if not in PATH
  timeout: 180                       # Optional: request timeout in seconds

# ═══════════════════════════════════════════════════════════════════════
# EXAMPLES: Full Configurations
# ═══════════════════════════════════════════════════════════════════════

# --- EXAMPLE 1: Anthropic with Model Selection ---
# Uncomment to use:
#
# anthropic:
#   api_key: "sk-ant-..."
#   model: "claude-opus-4-1"        # Best quality, slowest, most expensive
#   timeout: 120
#
# Usage: datalens analyze --source file --path data.csv --ai anthropic


# --- EXAMPLE 2: Anthropic Haiku (Fast & Cheap) ---
# Uncomment to use:
#
# anthropic:
#   api_key: "sk-ant-..."
#   model: "claude-haiku-4-5-20251001"  # Fastest, cheapest option
#   timeout: 60
#
# Usage: datalens analyze --source file --path data.csv --ai anthropic


# --- EXAMPLE 3: Multiple Providers (Use --ai Flag to Choose) ---
# Uncomment to use:
#
# anthropic:
#   api_key: "sk-ant-..."
#   model: "claude-sonnet-4-20250514"
#
# openai:
#   api_key: "sk-..."
#
# Usage:
#   datalens analyze --source file --path data.csv --ai anthropic  (uses Anthropic)
#   datalens analyze --source file --path data.csv --ai openai     (uses OpenAI)


# --- EXAMPLE 4: Claude Desktop (License) ---
# Uncomment to use (no API key needed, just CLI config):
#
# claude:
#   timeout: 180
#
# Usage: datalens analyze --source file --path data.csv --ai claude
# Note: Requires `claude` CLI authenticated via Claude Desktop/Code


# --- EXAMPLE 5: GitHub Copilot (License) ---
# Uncomment to use (no API key needed, just CLI config):
#
# copilot:
#   timeout: 180
#
# Usage: datalens analyze --source file --path data.csv --ai copilot
# Note: Requires `gh` CLI authenticated and active Copilot subscription


# --- EXAMPLE 6: Full Team Setup ---
# Uncomment to use for team environments:
#
# # Data sources
# mongodb:
#   uri: "mongodb+srv://user:pass@prod-cluster.mongodb.net"
#
# s3:
#   access_key_id: "AKIA..."
#   secret_access_key: "..."
#   region: "us-east-1"
#
# # AI (use --ai flag to choose)
# anthropic:
#   api_key: "sk-ant-..."
#   model: "claude-sonnet-4-20250514"
#
# openai:
#   api_key: "sk-..."


# --- EXAMPLE 7: Environment Variable References (Recommended) ---
# Instead of hardcoding, reference env vars:
#
# mongodb:
#   uri: "${MONGO_URI}"
#
# s3:
#   access_key_id: "${AWS_ACCESS_KEY_ID}"
#   secret_access_key: "${AWS_SECRET_ACCESS_KEY}"
#   region: "us-east-1"
#
# anthropic:
#   api_key: "${ANTHROPIC_API_KEY}"
#   model: "claude-sonnet-4-20250514"
#
# Then set in .env or shell:
#   export MONGO_URI="mongodb+srv://..."
#   export ANTHROPIC_API_KEY="sk-ant-..."


# ═══════════════════════════════════════════════════════════════════════
# MODEL COMPARISON FOR ANTHROPIC
# ═══════════════════════════════════════════════════════════════════════

# Model: claude-opus-4-1
# Speed: Slower (~5-10 seconds per analysis)
# Cost: Higher (~$3 per typical analysis)
# Quality: Highest — best for complex analysis, edge cases
# Use when: You need thorough insights, cost is not a concern

# Model: claude-sonnet-4-20250514
# Speed: Balanced (~2-3 seconds per analysis)
# Cost: Balanced (~$0.30 per typical analysis)
# Quality: Very good — best overall balance
# Use when: Default choice, recommended for most use cases

# Model: claude-haiku-4-5-20251001
# Speed: Fast (~1 second per analysis)
# Cost: Low (~$0.08 per typical analysis)
# Quality: Good — sufficient for simple insights
# Use when: Cost is important, quick turnarounds needed


# ═══════════════════════════════════════════════════════════════════════
# GETTING STARTED
# ═══════════════════════════════════════════════════════════════════════

# 1. COPY THIS FILE:
#    cp .datalens/secrets.yaml.example .datalens/secrets.yaml
#
# 2. UNCOMMENT THE SECTION YOU NEED (see examples above)
#
# 3. FILL IN YOUR CREDENTIALS:
#    - For Anthropic: Get API key from https://console.anthropic.com/
#    - For OpenAI: Get API key from https://platform.openai.com/
#    - For Claude Desktop: Install and authenticate via `claude auth login`
#    - For GitHub Copilot: Install gh and run `gh auth login`
#
# 4. RUN ANALYSIS WITH AI:
#    datalens analyze --source file --path data.csv --ai anthropic
#    datalens analyze --source file --path data.csv --ai openai
#    datalens analyze --source file --path data.csv --ai claude
#    datalens analyze --source file --path data.csv --ai copilot
#
# 5. AUTO-DETECT (RECOMMENDED):
#    datalens analyze --source file --path data.csv --ai auto
#    (tries licensed providers first, then API keys)


# ═══════════════════════════════════════════════════════════════════════
# SECURITY NOTES
# ═══════════════════════════════════════════════════════════════════════

# - Never commit this file to git (it's in .gitignore)
# - Keep API keys confidential
# - Consider using environment variables instead of hardcoding secrets
# - If compromised, regenerate API keys immediately
# - For team setups, use CI secrets or private vaults for credentials
